root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Matches Android Studio's built-in Kotlin formatter, so the IDE and ktlint agree.
ktlint_code_style = android_studio
max_line_length = 120
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,toml,json,xml}]
indent_size = 2
