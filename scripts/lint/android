#!/usr/bin/env bash
# Android Lint for every module: manifests, resources, API levels and Compose usage.
# Extra arguments are passed to Gradle, e.g. `./scripts/lint/android --continue`.
set -o errexit -o nounset -o pipefail

cd "$(git rev-parse --show-toplevel)"

./gradlew lintDebug --stacktrace "$@"
