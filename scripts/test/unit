#!/usr/bin/env bash
# Unit tests for every module.
#
# `test` covers both Android modules and pure-Kotlin modules (`:core:common`, `:core:model`),
# which `testDebugUnitTest` alone would skip. AGP only creates unit tests for the debug build
# type, so this doesn't run them twice.
set -o errexit -o nounset -o pipefail

cd "$(git rev-parse --show-toplevel)"

./gradlew test --continue --stacktrace "$@"
