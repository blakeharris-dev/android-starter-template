#!/usr/bin/env bash
# Unit tests for every module.
#
# `test` covers both Android modules and pure-Kotlin modules (`:core:common`, `:core:model`),
# which `testDebugUnitTest` alone would skip. Release unit tests are excluded: they repeat the
# debug ones.
set -o errexit -o nounset -o pipefail

cd "$(git rev-parse --show-toplevel)"

./gradlew test -x testReleaseUnitTest --continue --stacktrace "$@"
